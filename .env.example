# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String
# Leave empty to use built-in local persistent JSON database for development,
# or supply your MongoDB Atlas connection URI:
MONGODB_URI=

# JWT Authentication Secret
JWT_SECRET=your-random-jwt-secret-key-change-in-production

# Admin Credentials (CTO / Event Admin)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your-secure-admin-password

# Google OAuth Credentials (Enables native Google One-Tap & Account Selector)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Client Application URL
CLIENT_URL=http://localhost:5173
